generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model StudioSettings {
  id          String   @id @default(cuid())
  studioName  String
  defaultIp   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntellectualProperty {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  series       Series[]
  publications Publication[]
}

model Series {
  id           String               @id @default(cuid())
  ipId         String
  slug         String               @unique
  name         String
  volumeNumber Int?
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  ip           IntellectualProperty @relation(fields: [ipId], references: [id], onDelete: Cascade)
  publications Publication[]
}

model Publication {
  id            String               @id @default(cuid())
  publicationId String               @unique
  projectId     String
  projectSlug   String
  channel       String
  language      String
  sourceSystem  String?
  status        String
  payloadJson   Json
  warningsJson  Json?
  errorsJson    Json?
  ipId          String
  seriesId      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  ip            IntellectualProperty @relation(fields: [ipId], references: [id], onDelete: Cascade)
  series        Series?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  variants      PublicationVariant[]
}

model PublicationVariant {
  id               String              @id @default(cuid())
  publicationIdRef String
  variantId        String              @unique
  projectId        String
  projectSlug      String
  channel          String
  language         String
  format           String
  slug             String              @unique
  title            String
  subtitle         String?
  description      String
  shortDescription String?
  price            Decimal?            @db.Decimal(10, 2)
  currency         String?
  payloadJson      Json
  published        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  publication      Publication         @relation(fields: [publicationIdRef], references: [publicationId], onDelete: Cascade)
  assets           PublicationAsset[]
  products         Product[]
}

model PublicationAsset {
  id           String             @id @default(cuid())
  variantIdRef String
  role         String
  fileUrl      String
  mimeType     String?
  createdAt    DateTime           @default(now())

  variant      PublicationVariant @relation(fields: [variantIdRef], references: [variantId], onDelete: Cascade)
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(CUSTOMER)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  library       CustomerLibrary[]
  checkouts     Checkout[]
}

model Product {
  id                   String             @id @default(cuid())
  publicationVariantId String
  slug                 String             @unique
  title                String
  type                 ProductType
  priceCents           Int
  currency             String             @default("EUR")
  active               Boolean            @default(false)
  featured             Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  variant              PublicationVariant @relation(fields: [publicationVariantId], references: [variantId], onDelete: Cascade)
  libraryEntries       CustomerLibrary[]
  checkoutItems        CheckoutItem[]
}

model BundleGroup {
  id           String            @id @default(cuid())
  groupId      String            @unique
  slug         String            @unique
  name         String
  description  String?
  groupType    String            @default("bundle")
  priceCents   Int               @default(0)
  currency     String            @default("EUR")
  active       Boolean           @default(false)
  featured     Boolean           @default(false)
  sourceSystem String?
  payloadJson  Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items        BundleGroupItem[]
}

model BundleGroupItem {
  id           String       @id @default(cuid())
  bundleIdRef  String
  productId    String?
  productSlug  String?
  title        String
  type         String?
  currency     String?
  priceCents   Int          @default(0)
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bundle       BundleGroup  @relation(fields: [bundleIdRef], references: [groupId], onDelete: Cascade)

  @@index([bundleIdRef, position])
}

model SagaVisualSet {
  id           String   @id @default(cuid())
  visualSetId  String   @unique
  sagaSlug     String   @unique
  displayName  String
  active       Boolean  @default(false)
  version      Int      @default(1)
  sourceSystem String?
  payloadJson  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomerLibrary {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  grantedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Checkout {
  id          String           @id @default(cuid())
  userId      String
  provider    CheckoutProvider
  providerRef String?          @unique
  amountCents Int
  currency    String           @default("EUR")
  status      CheckoutStatus   @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CheckoutItem[]
}

model CheckoutItem {
  id              String    @id @default(cuid())
  checkoutId      String
  productId       String
  quantity        Int       @default(1)
  unitAmountCents Int

  checkout        Checkout  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([checkoutId, productId])
}

enum ProductType {
  EBOOK
  AUDIOBOOK
  VIDEO
  BUNDLE
}

enum CheckoutProvider {
  STRIPE
  PAYPAL
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CUSTOMER
}
